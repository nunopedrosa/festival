# Festival static PWA on DreamHost Apache.
# Installed by scripts/deploy.sh ONLY when the web directory has no .htaccess.
# If a file already exists, merge this snippet manually without removing its rules.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# Runtime filenames are stable. Revalidate on the network; the service worker
# independently retains a complete offline release until the user updates it.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|webmanifest|svg|png)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
